{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Exécutés tels quels par Node 24 (type stripping) : syntaxe TypeScript effaçable seulement.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"]
  },
  "include": ["*.mts"]
}
