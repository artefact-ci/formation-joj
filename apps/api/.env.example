# Copier en apps/api/.env pour changer la configuration (facultatif).

# Port de l'API (3000 par défaut).
# PORT=3000

# Sans DATABASE_URL : PGlite, une base Postgres embarquée, stockée dans PGLITE_DATA_DIR.
# PGLITE_DATA_DIR=.data/pglite

# Avec Docker (docker compose up -d), décommenter pour utiliser un vrai Postgres :
# DATABASE_URL=postgres://joj:joj@localhost:5432/joj
