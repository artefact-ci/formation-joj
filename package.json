{
  "name": "formation-joj",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "pnpm -r typecheck && tsc -p .claude/hooks",
    "db:generate": "pnpm --filter @joj/api db:generate",
    "db:seed": "pnpm --filter @joj/api db:seed",
    "db:reset": "pnpm --filter @joj/api db:reset"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.3",
    "vitest": "~5.0.5"
  },
  "engines": {
    "node": ">=24.11"
  },
  "packageManager": "pnpm@10.34.9"
}
